FROM docker.io/library/node:20.18-alpine AS build
RUN apk add --no-cache git openssh && rm -rf /var/cache/apk/*
WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn
COPY .babel-plugin-macrosrc.js tsconfig.json ./
COPY public ./public
COPY src ./src
ARG REACT_APP_MODE
ARG REACT_APP_ONESIGNAL_APP_ID
ARG REACT_APP_SME_ENDPOINT
ARG REACT_APP_GRAPHQL_ENDPOINT
ARG REACT_APP_GRAPHQL_WS_ENDPOINT
ARG REACT_APP_URL_FILE_UPLOAD
ARG REACT_APP_CHATTING_SOCKET_URL
ARG REACT_APP_VERSION
ENV REACT_APP_MODE=$REACT_APP_MODE
ENV REACT_APP_ONESIGNAL_APP_ID=$REACT_APP_ONESIGNAL_APP_ID
ENV REACT_APP_SME_ENDPOINT=$REACT_APP_SME_ENDPOINT
ENV REACT_APP_GRAPHQL_ENDPOINT=$REACT_APP_GRAPHQL_ENDPOINT
ENV REACT_APP_GRAPHQL_WS_ENDPOINT=$REACT_APP_GRAPHQL_WS_ENDPOINT
ENV REACT_APP_URL_FILE_UPLOAD=$REACT_APP_URL_FILE_UPLOAD
ENV REACT_APP_CHATTING_SOCKET_URL=$REACT_APP_CHATTING_SOCKET_URL
ENV REACT_APP_VERSION=$REACT_APP_VERSION
ENV NODE_ENV=production
ENV GENERATE_SOURCEMAP=false
RUN yarn run build

FROM docker.io/library/nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
CMD ["nginx", "-g", "daemon off;"]
